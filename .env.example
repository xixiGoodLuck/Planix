AI_PROVIDER=mock
AI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
OPENAI_API_KEY=
AI_API_BASE=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
USE_REAL_LLM=0
# PostgreSQL 17 local development configuration.
PLANIX_POSTGRES_PORT=5432
DATABASE_URL=postgresql://planix:planix@127.0.0.1:5432/planix
PLANIX_DB_POOL_MIN=1
PLANIX_DB_POOL_MAX=5
PLANIX_DB_POOL_TIMEOUT=10
# Learning Runtime runs in production mode by default.
PLANIX_LEARNING_ENVIRONMENT=production
